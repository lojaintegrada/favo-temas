{
  "$schema": "https://cdn.awsli.com.br/public/render/schema/v1.json",
  "partial": {
    "path": "/partial/header/menu-mobile",
    "components": [
      {
        "data": {
          "categories": {
            "function": "get_category_tree"
          },
          "institutional_pages": {
            "function": "get_institutional_pages"
          },
          "suggestion_products": {
            "function": "get_products",
            "args": {
              "size": 2,
              "preset": "BestSellingProducts"
            }
          }
        },
        "template": "shared/components/header/components/navbar/navigation-content.liquid"
      }
    ]
  },
  "_version": "3",
  "global_data": {}
}
