{
  "html": {
    "body": {
      "components": [
        {
          "type": "template",
          "template": "shared/components/banner/stripe.liquid"
        },
        {
          "tag": "header",
          "type": "container",
          "components": [
            {
              "type": "template",
              "template": "shared/components/header/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/header/components/floating-bar/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/header/components/menu/index.liquid",
              "data": {
                "categories": {
                  "function": "get_category_tree"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/header/components/segmented-price/index.liquid"
            }
          ]
        },
        {
          "tag": "main",
          "type": "container",
          "components": [
            {
              "type": "template",
              "template": "shared/components/banner/full.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "home",
                    "position": "full"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/stripe-banners.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "home",
                    "position": "stripe"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "block",
              "block": "shelf_highlights",
              "data": {
                "shelf_result": {
                  "function": "get_products",
                  "args": {
                    "preset": "HighlightedProducts",
                    "size": 8
                  }
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/showcase-odd.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "home",
                    "position": "showcase"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/mini.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "home",
                    "position": "mini"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "block",
              "block": "shelf_newest",
              "data": {
                "shelf_result": {
                  "function": "get_products",
                  "args": {
                    "preset": "NewestProducts",
                    "size": 8
                  }
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/showcase-even.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "home",
                    "position": "showcase"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "block",
              "block": "shelf_bestselling",
              "data": {
                "shelf_result": {
                  "function": "get_products",
                  "args": {
                    "preset": "BestSellingProducts",
                    "size": 8
                  }
                }
              }
            }
          ]
        },
        {
          "tag": "footer",
          "type": "container",
          "components": [
            {
              "template": "shared/components/footer/container.liquid",
              "data": {
                "store": {
                  "function": "get_store"
                },
                "categories": {
                  "function": "get_category_tree"
                },
                "payment_conditions": {
                  "function": "get_payment_conditions"
                },
                "institutional_pages": {
                  "function": "get_institutional_pages"
                }
              }
            },
            {
              "template": "shared/components/footer/copyright.liquid",
              "data": {
                "store": {
                  "function": "get_store"
                }
              }
            }
          ]
        },
        {
          "template": "shared/utils/index.liquid"
        }
      ]
    },
    "head": {
      "components": [
        {
          "template": "shared/components/head/style-general.liquid"
        },
        {
          "template": "shared/components/head/seo.liquid",
          "data": {
            "store": {
              "function": "get_store"
            }
          }
        },
        {
          "template": "shared/components/head/script-general.liquid"
        }
      ]
    }
  },
  "path": "/",
  "$schema": "https://cdn.awsli.com.br/public/render/schema/pages-v4.json",
  "_version": "4",
  "global_data": {}
}
