{
  "html": {
    "body": {
      "components": [
        {
          "type": "template",
          "template": "shared/components/banner/stripe.liquid"
        },
        {
          "tag": "header",
          "type": "container",
          "class": "border-b border-base-200",
          "components": [
            {
              "type": "template",
              "template": "shared/components/header/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/header/components/floating-bar/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/header/components/menu/index.liquid",
              "data": {
                "categories": {
                  "function": "get_category_tree"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/header/components/segmented-price/index.liquid"
            }
          ]
        },
        {
          "tag": "main",
          "type": "container",
          "components": [
            {
              "type": "template",
              "template": "shared/components/banner/full.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "search",
                    "position": "full"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/stripe-banners.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "search",
                    "position": "stripe"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/mini.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "search",
                    "position": "mini"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/breadcrumb/index.liquid"
            },
            {
              "template": "pages/search/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/banner/showcase.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "search",
                    "position": "showcase"
                  },
                  "function": "get_banners"
                }
              }
            }
          ]
        },
        {
          "tag": "footer",
          "type": "container",
          "components": [
            {
              "template": "shared/components/footer/container.liquid",
              "data": {
                "store": {
                  "function": "get_store"
                },
                "categories": {
                  "function": "get_category_tree"
                },
                "payment_conditions": {
                  "function": "get_payment_conditions"
                },
                "institutional_pages": {
                  "function": "get_institutional_pages"
                }
              }
            },
            {
              "template": "shared/components/footer/copyright.liquid",
              "data": {
                "store": {
                  "function": "get_store"
                }
              }
            }
          ]
        },
        {
          "template": "shared/utils/index.liquid"
        }
      ]
    },
    "head": {
      "components": [
        {
          "template": "shared/components/head/style-general.liquid"
        },
        {
          "template": "shared/components/head/seo.liquid"
        },
        {
          "template": "shared/components/head/script-general.liquid"
        }
      ]
    }
  },
  "path": "/[search]",
  "$schema": "https://cdn.awsli.com.br/public/render/schema/pages-v4.json",
  "_version": "4",
  "global_data": {
    "search_result": {
      "args": {
        "default_sort": "_score:desc",
        "default_page_size": 20
      },
      "function": "search_products"
    }
  }
}
