{
  "html": {
    "body": {
      "components": [
        {
          "type": "template",
          "template": "shared/components/banner/stripe.liquid"
        },
        {
          "tag": "header",
          "type": "container",
          "class": "border-b border-base-200",
          "components": [
            {
              "type": "template",
              "template": "shared/components/header/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/header/components/floating-bar/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/header/components/menu/index.liquid",
              "data": {
                "categories": {
                  "function": "get_category_tree"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/header/components/segmented-price/index.liquid"
            }
          ]
        },
        {
          "tag": "main",
          "type": "container",
          "components": [
            {
              "type": "template",
              "template": "shared/components/banner/full.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "product",
                    "position": "full"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/stripe-banners.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "product",
                    "position": "stripe"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/banner/mini.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "product",
                    "position": "mini"
                  },
                  "function": "get_banners"
                }
              }
            },
            {
              "id": "product-details",
              "class": "container my-5 md:pt-10 grid grid-cols-1 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-5 md:gap-y-0 md:gap-x-10",
              "tag": "div",
              "type": "container",
              "components": [
                {
                  "type": "template",
                  "template": "shared/components/breadcrumb/index.liquid"
                },
                {
                  "template": "pages/product/components/images/index.liquid"
                },
                {
                  "template": "pages/product/index.liquid"
                },
                {
                  "class": "md:mt-10 md:col-start-1 divide-y divide-base-200 has-[*]:border-t border-base-200",
                  "tag": "div",
                  "type": "container",
                  "components": [
                    {
                      "type": "template",
                      "template": "pages/product/components/buy-together/before-product.liquid",
                      "data": {
                        "buy_together": {
                          "function": "get_buy_together"
                        }
                      }
                    },
                    {
                      "template": "pages/product/components/description/index.liquid"
                    },
                    {
                      "type": "template",
                      "template": "pages/product/components/buy-together/after-product.liquid",
                      "data": {
                        "buy_together": {
                          "function": "get_buy_together"
                        }
                      }
                    },
                    {
                      "type": "template",
                      "template": "pages/product/components/reviews/index.liquid"
                    }
                  ]
                }
              ]
            },
            {
              "template": "pages/product/components/payments-modal/index.liquid",
              "data": {
                "payment_conditions": {
                  "function": "get_product_installments"
                }
              }
            },
            {
              "type": "template",
              "template": "pages/product/components/recommendations/index.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/banner/showcase.liquid",
              "data": {
                "banners": {
                  "args": {
                    "location": "product",
                    "position": "showcase"
                  },
                  "function": "get_banners"
                }
              }
            }
          ]
        },
        {
          "tag": "footer",
          "type": "container",
          "components": [
            {
              "template": "shared/components/footer/container.liquid",
              "data": {
                "store": {
                  "function": "get_store"
                },
                "categories": {
                  "function": "get_category_tree"
                },
                "payment_conditions": {
                  "function": "get_payment_conditions"
                },
                "institutional_pages": {
                  "function": "get_institutional_pages"
                }
              }
            },
            {
              "template": "shared/components/footer/copyright.liquid",
              "data": {
                "store": {
                  "function": "get_store"
                }
              }
            }
          ]
        },
        {
          "template": "shared/utils/index.liquid"
        }
      ]
    },
    "head": {
      "components": [
        {
          "template": "shared/components/head/style-general.liquid"
        },
        {
          "template": "shared/components/head/seo.liquid"
        },
        {
          "template": "shared/components/head/script-general.liquid"
        }
      ]
    }
  },
  "path": "/[product]",
  "$schema": "https://cdn.awsli.com.br/public/render/schema/pages-v4.json",
  "_version": "4",
  "global_data": {}
}
