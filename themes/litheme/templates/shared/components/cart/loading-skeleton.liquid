<div class="relative">
  {% render 'shared/components/cart/title' %}
  <div class="opacity-20 grid grid-cols-1 md:grid-cols-[4fr_3fr] lg:grid-cols-[2fr_1fr] in-[minicart-drawer]:grid-cols-1! gap-3">
    <div class="flex flex-col divide-y divide-base-200">
      {%- for i in (1..2) -%}
        <div class="flex items-center gap-4 px-5 py-4">
          <div class="skeleton size-20 shrink-0 rounded-xl"></div>
          <div class="flex flex-row gap-4 w-full">
            <div class="flex flex-col justify-between gap-2 grow">
              <div class="skeleton h-4 w-4/5 rounded"></div>
              <div class="skeleton h-3 w-2/4 rounded"></div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <div class="skeleton h-11 w-20 rounded-full"></div>
              <div class="skeleton size-8 rounded-full"></div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="flex flex-col gap-4 p-5 border-t border-base-200">
      <div class="flex gap-2">
        <div class="skeleton h-10 flex-1 rounded-full"></div>
        <div class="skeleton h-10 flex-1 rounded-full"></div>
      </div>
      <div class="flex flex-col gap-4">
        <div class="flex justify-between">
          <div class="skeleton h-4 w-16 rounded"></div>
          <div class="skeleton h-4 w-24 rounded"></div>
        </div>
        <div class="flex justify-between">
          <div class="skeleton h-4 w-28 rounded"></div>
          <div class="skeleton h-4 w-28 rounded"></div>
        </div>
      </div>
      <div class="skeleton h-14 w-full rounded-full"></div>
    </div>
  </div>
  <button
    class="absolute inset-0 flex items-center justify-center bg-neutral disabled:hidden transition-opacity delay-300 starting:opacity-0"
    onclick="document.body.dispatchEvent(new CustomEvent('li-minicart-opened', {bubbles: true}))"
    title="Atualizar carrinho"
    disabled
  >
    <div class="btn">
      <svg class="fill-current size-4" role="img" aria-hidden="true">
        <use xlink:href="/static/img/fontawesome-solid.svg#rotate" href="/static/img/fontawesome-solid.svg#rotate"></use>
      </svg>
    </div>
  </button>
</div>
