{%- comment -%}
  Componente: Gift Missing Modal
  Descrição: Pergunta ao finalizar a compra com brinde ainda não escolhido. Precisa vir logo depois
    do botão "Finalizar compra", que abre o modal via this.nextElementSibling.showModal()
  Props esperadas via data.cart.gift_choice (nil quando não há brinde para escolher)
{%- endcomment -%}

{% if data.cart.gift_choice %}
  <dialog class="modal modal-bottom sm:modal-middle" aria-label="Você ganhou um brinde" data-testid="li-minicart-gift-choice-modal">
    <div class="modal-box bg-neutral flex flex-col gap-3 sm:max-w-sm">
      <div class="flex items-center gap-3">
        <svg class="fill-current size-5 text-success shrink-0" role="img" aria-hidden="true">
          <use xlink:href="/static/img/fontawesome-solid.svg#gift" href="/static/img/fontawesome-solid.svg#gift"></use>
        </svg>
        <h3 class="text-lg font-medium text-base-content leading-6">Você ganhou um brinde</h3>
      </div>
      <p class="text-sm text-base-content/70">Falta escolher. Quer escolher antes de finalizar?</p>
      <button
        type="button"
        class="btn btn-primary btn-block mt-2"
        onclick="
          this.closest('dialog').close();
          const choice = this.closest('[data-id=minicart-content]')?.querySelector('[data-id=cart-gift-choice]');
          const open = choice?.querySelector('[data-id=gift-choice-open]');
          open ? open.click() : choice?.querySelector('select, button')?.focus();
        "
        data-testid="li-minicart-gift-choice-modal-choose"
      >
        Escolher brinde
      </button>
      <a href="/checkout" class="btn btn-ghost btn-block" data-testid="li-minicart-gift-choice-modal-skip">Continuar sem brinde</a>
    </div>
    <form method="dialog" class="modal-backdrop"><button>Fechar</button></form>
  </dialog>
{% endif %}
