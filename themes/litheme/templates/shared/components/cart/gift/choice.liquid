{%- comment -%}
  Componente: Gift Choice
  Descrição: Seletor do brinde que o cliente precisa escolher antes de finalizar a compra
  Props esperadas via data.cart.gift_choice (nil quando não há brinde para escolher)
{%- endcomment -%}

{%- assign choice = data.cart.gift_choice -%}

{% if choice %}
  <section
    class="mx-5 mb-4 p-4 flex flex-col gap-3 bg-success/10 border border-dashed border-success rounded-box"
    aria-label="Escolha seu brinde"
    data-id="cart-gift-choice"
    data-testid="li-cart-gift-choice"
  >
    <div class="flex items-center gap-3">
      <svg class="fill-current size-5 text-success shrink-0" role="img" aria-hidden="true">
        <use xlink:href="/static/img/fontawesome-solid.svg#gift" href="/static/img/fontawesome-solid.svg#gift"></use>
      </svg>
      <h2 class="flex-1 text-base font-semibold text-base-content leading-6">Escolha seu brinde</h2>
      {% if choice.total > 1 %}
        <span class="badge badge-sm badge-soft badge-success shrink-0">{{ choice.current }} de {{ choice.total }}</span>
      {% endif %}
    </div>
    <ul role="list" class="flex flex-col divide-y divide-success/20">
      {% for product in choice.products %}
        <li>
          <form
            class="group flex items-center gap-4 py-3"
            hx-post="{{ routes.cart_gift }}"
            hx-swap="none"
            hx-disable="find button, find select"
            data-testid="li-cart-gift-choice-option"
          >
            <input type="hidden" name="offer_id" value="{{ choice.offer_id }}" />
            <div class="size-16 shrink-0 overflow-hidden">
              <img src="{{ ctx.static_domain }}/80x80/{{ product.images[0].path | default: '0/0/common/product-no-image.gif' }}" alt="{{ product.name }}" class="h-full w-full object-contain object-center rounded-xl" loading="lazy" />
            </div>
            <div class="flex-1 min-w-0 flex flex-col gap-2">
              <div>
                <p class="text-sm font-medium text-base-content leading-5 break-words">{{ product.name }}</p>
                {%- assign option = product.options.first -%}
                {% if product.options.size == 1 and option.variation_name and option.variation_name != product.name %}
                  <p class="mt-0.5 text-xs font-light text-base-content/70">{{ option.variation_name }}</p>
                {% endif %}
                <p class="mt-0.5 text-sm">
                  {% if product.price > 0 %}
                    <s class="text-xs text-base-content/70">{{ product.price | format_number: "C" }}</s>
                  {% endif %}
                  <span class="font-bold text-success">Grátis</span>
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                {% if product.options.size > 1 %}
                  <select name="product_id" class="select w-auto min-w-0" aria-label="Variação de {{ product.name }}">
                    {% for option in product.options %}
                      <option value="{{ option.id }}">{{ option.variation_name }}</option>
                    {% endfor %}
                  </select>
                {% else %}
                  <input type="hidden" name="product_id" value="{{ option.id }}" />
                {% endif %}
                <button type="submit" class="relative btn btn-secondary btn-sm shrink-0" data-testid="li-cart-gift-choice-submit">
                  <span class="group-[.htmx-request]:opacity-0">Escolher</span>
                  <span class="hidden group-[.htmx-request]:flex absolute inset-0 items-center justify-center">
                    <svg class="fill-current size-4 animate-spin" role="img" aria-hidden="true">
                      <use xlink:href="/static/img/fontawesome-solid.svg#spinner" href="/static/img/fontawesome-solid.svg#spinner"></use>
                    </svg>
                  </span>
                </button>
              </div>
            </div>
          </form>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
