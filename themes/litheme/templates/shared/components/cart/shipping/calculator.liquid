<bottom-sheet-dialog class="bottom-sheet active">
  <div 
    class="bottom-sheet-overlay bottom-sheet-close"
  ></div>
  
  <div class="bottom-sheet-content bottom-sheet-content-dialog">
    <div id="freight-calculator-container" class="p-6 bg-neutral flex flex-col gap-2.5">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-medium text-base-content">Calcular frete</h3>
        <button 
          type="button"
          class="bottom-sheet-close"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <mask id="mask0_772_16736" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="20" height="20">
            <rect width="20" height="20" fill="#D9D9D9"/>
            </mask>
            <g mask="url(#mask0_772_16736)">
            <path d="M5.33317 15.8334L4.1665 14.6667L8.83317 10.0001L4.1665 5.33341L5.33317 4.16675L9.99984 8.83341L14.6665 4.16675L15.8332 5.33341L11.1665 10.0001L15.8332 14.6667L14.6665 15.8334L9.99984 11.1667L5.33317 15.8334Z" fill="currentColor"/>
            </g>
          </svg>
        </button>
      </div>
      <form 
        id="minicart-zipcode-form" 
        class="flex flex-col gap-4" 
        hx-post="{{ routes.cart_zipcode }}" 
        hx-target="#minicart-shipping-calculation" 
        hx-swap="outerHTML" 
        hx-disabled-elt="find button, find input"
      >
        {% render 'shared/components/cart/shipping/result', with_session: with_session %}
      </form>
    </div>
  </div>
</bottom-sheet-dialog>

<script defer src="{% asset_url '/scripts/bottom-sheet-dialog.webc.js' %}"></script>
