{% if data.suggestion_products.products.size > 0 %}
  <div data-id="minicart-product-suggestion" data-metrics="view_item_list" data-mt-list-id="sugestoes-carrinho" data-mt-list-name="Sugestões do carrinho">
    <p class="px-5 pb-8 text-base font-base text-center">
      Não sabe por onde começar?
      <br class="hidden in-[minicart-drawer]:block!" />
      Veja os produtos abaixo.</p>
    <div class="grid grid-cols-2 gap-6 mx-auto max-w-lg px-6">
      {%- assign img_height = '200' -%}
      {%- assign img_width = img_height | times: 2 -%}
      {% for product in data.suggestion_products.products %}
        {% render 'shared/components/product-card/index', product: product, forloop: forloop, img_width: img_width, img_height: img_height, sizes: "(max-width: 512px) 50vw, 220px" %}
      {% endfor %}
    </div>
  </div>
{% endif %}
