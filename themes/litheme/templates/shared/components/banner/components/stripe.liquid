{%- assign srcset_widths = '320,412,768,1280,1920' | split: ',' -%}
{%- assign srcset_widths_mobile = '320,360,412,540,768' | split: ',' -%}
<div class="container py-4 space-y-4 content-auto-[100px]">
  {% for banner in banners %}
    {% if banner %}
      <div class="w-full">
        {% if banner.url and banner.url contains '/' %}
          <a href="{{ banner.url }}" target="{{ banner.target | default:'_self' }}" class="block">
        {% endif %}
          <picture class="block rounded-box relative">
            {% assign image_mobile = banner.image_mobile %}
            {% if image_mobile %}
              <source
                media="(max-width:767px)"
                srcset="{% for w in srcset_widths_mobile %}{{ ctx.static_domain }}/{{ w }}x200{{ image_mobile }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                sizes="100vw"
                width="{{ banner.width_mobile | default: 767 }}"
                height="{{ banner.height_mobile | default: 200 }}"
              />
            {% endif %}
            <img
              src="{{ ctx.static_domain }}/1280x200{{ banner.image }}"
              srcset="{% for w in srcset_widths %}{{ ctx.static_domain }}/{{ w }}x200{{ banner.image }} {{ w }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
              sizes="100vw"
              alt="{{ banner.alt }}"
              width="{{ banner.width | default: 1280 }}"
              height="{{ banner.height | default: 200 }}"
              class="block mx-auto"
              loading="lazy"
            />
          </picture>
        {% if banner.url and banner.url contains '/' %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>
