{% if product.available and product.price.upon_request == false and product.hide_price != true %}
  {%- assign discount_percentage = product.price.discount_percentage -%}
  {%- assign offers_teasers = product.price.offers_teasers -%}
{% endif %}
{% comment %} Calculo de produto lançamento {% endcomment %}
{%- assign now = 'now' | date: '%s' -%}
{%- assign product_created_at = product.created_at | date: '%s' -%}
{%- assign product_created_at = now | minus: product_created_at -%}
{%- assign product_created_at = product_created_at | divided_by: 86400 | round: 0 -%}

<div class="absolute top-1 left-1 gap-1 flex flex-wrap">
  {%- if discount_percentage > 0 -%}
    <span class="badge badge-soft badge-primary badge-sm">
      -{{ discount_percentage | round: 0 }}%
    </span>
  {%- endif -%}
  {%- for teaser in offers_teasers limit: 1 -%}
    <span class="badge badge-soft badge-primary badge-sm">
      {{ teaser }}
    </span>
  {%- endfor -%}
  {%- if product_created_at < 30 -%}
    <span class="badge badge-soft badge-success badge-sm">
      Lançamento
    </span>
  {%- endif -%}
  {%- if product.free_shipping -%}
    <span class="badge badge-soft badge-success badge-sm">
      Frete Grátis
    </span>
  {%- endif -%}
</div>
