{%- assign social_youtube = props.social_networks.youtube | default: data.store.social_networks.youtube -%}
{%- assign social_twitter = props.social_networks.twitter | default: data.store.social_networks.twitter -%}
{%- assign social_tiktok = props.social_networks.tiktok | default: data.store.social_networks.tiktok -%}
{%- assign social_threads = props.social_networks.threads | default: data.store.social_networks.threads -%}
{%- assign social_pinterest = props.social_networks.pinterest | default: data.store.social_networks.pinterest -%}
{%- assign social_linkedin = props.social_networks.linkedin | default: data.store.social_networks.linkedin -%}
{%- assign social_instagram = props.social_networks.instagram | default: data.store.social_networks.instagram -%}
{%- assign social_facebook = props.social_networks.facebook | default: data.store.social_networks.facebook -%}
{%- assign social_blog = props.social_networks.blog | default: data.store.social_networks.blog -%}
{%- assign has_social_networks = social_youtube or social_twitter or social_tiktok or social_threads or social_pinterest or social_linkedin or social_instagram or social_facebook or social_blog -%}
{%- if has_social_networks -%}
  <div class="collapse collapse-open pb-5 pt-3 border-b border-base-200 md:order-10 md:col-span-3 md:border-b-0 md:pt-0">
    <input type="radio" name="footer-accordion" class="md:hidden" aria-hidden="true" tabindex="-1" />
    <span class="collapse-title cursor-auto">Siga-nos nas redes sociais</span>
    <ul class="collapse-content flex flex-wrap gap-2.5 mt-2">
      {%- if social_youtube -%}
        <li class="inline-block">
          <a href="https://www.youtube.com/{{ social_youtube }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="YouTube">
            <svg class="fill-current size-3.5" role="img" aria-label="YouTube">
              <use xlink:href="/static/img/fontawesome-brands.svg#youtube" href="/static/img/fontawesome-brands.svg#youtube"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {%- if social_twitter -%}
        <li class="inline-block">
          <a href="https://x.com/{{ social_twitter }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="Twitter">
            <svg class="fill-current size-3.5" role="img" aria-label="Twitter">
              <use xlink:href="/static/img/fontawesome-brands.svg#x-twitter" href="/static/img/fontawesome-brands.svg#x-twitter"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {%- if social_tiktok -%}
        <li class="inline-block">
          <a href="https://www.tiktok.com/{{ social_tiktok }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="Tiktok">
            <svg class="fill-current size-3.5" role="img" aria-label="Tiktok">
              <use xlink:href="/static/img/fontawesome-brands.svg#tiktok" href="/static/img/fontawesome-brands.svg#tiktok"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {%- if social_threads -%}
        <li class="inline-block">
          <a href="https://www.threads.net/{{ social_threads }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="Instagram">
            <svg class="fill-current size-3.5" role="img" aria-label="Threads">
              <use xlink:href="/static/img/fontawesome-brands.svg#threads" href="/static/img/fontawesome-brands.svg#threads"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {%- if social_pinterest -%}
        <li class="inline-block">
          <a href="https://pinterest.com/{{ social_pinterest }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="Pinterest">
            <svg class="fill-current size-3.5" role="img" aria-label="Pinterest">
              <use xlink:href="/static/img/fontawesome-brands.svg#pinterest-p" href="/static/img/fontawesome-brands.svg#pinterest-p"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {%- if social_linkedin -%}
        <li class="inline-block">
          <a href="https://www.linkedin.com/company/{{ social_linkedin }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="LinkedIn">
            <svg class="fill-current size-3.5" role="img" aria-label="LinkedIn">
              <use xlink:href="/static/img/fontawesome-brands.svg#linkedin-in" href="/static/img/fontawesome-brands.svg#linkedin-in"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {%- if social_instagram -%}
        <li class="inline-block">
          <a href="https://www.instagram.com/{{ social_instagram }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="Instagram">
            <svg class="fill-current size-3.5" role="img" aria-label="Instagram">
              <use xlink:href="/static/img/fontawesome-brands.svg#instagram" href="/static/img/fontawesome-brands.svg#instagram"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {% if social_facebook -%}
        <li class="inline-block">
          <a href="https://www.facebook.com/{{ social_facebook }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="Facebook">
            <svg class="fill-current size-3.5" role="img" aria-label="Facebook">
              <use xlink:href="/static/img/fontawesome-brands.svg#square-facebook" href="/static/img/fontawesome-brands.svg#square-facebook"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
      {%- if social_blog -%}
        <li class="inline-block">
          <a href="{{ social_blog }}" target="_blank" class=" p-3 size-10.5 rounded-full bg-base-300 flex items-center justify-center transition-transform hover:scale-110" rel="noopener" title="Blog">
            <svg class="fill-current size-3.5" role="img" aria-label="Blog">
              <use xlink:href="/static/img/fontawesome-brands.svg#blogger" href="/static/img/fontawesome-brands.svg#blogger"></use>
            </svg>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}
