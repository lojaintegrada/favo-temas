  <script>
    (function() {
      // Disable view transitions for Meta browsers (Facebook, Instagram) due to known issues with their webview implementations.
      var isMetaBrowser = /FBAN|FBAV|Instagram/i.test(navigator.userAgent);
      if (!isMetaBrowser) {
        var style = document.createElement('style');
        style.textContent = '@view-transition { navigation: auto; }';
        document.head.appendChild(style);
      }
    })();
  </script>

