{%- assign current_page = ctx.url.querystring.page | default: 1 | plus: 0 -%}
{%- if data.category -%}
  {%- assign list_id = 'categoria-' | append: data.category.id -%}
{%- elsif data.brand -%}
  {%- assign list_id = 'marca-' | append: data.brand.id -%}
{%- else -%}
  {%- assign list_id = 'busca' -%}
{%- endif -%}
{% if data.search_result.products.size > 0 %}
  <div
    class="grid grid-cols-2 gap-5 sm:grid-cols-2 lg:grid-cols-3"
    id="li-search-results-grid"
    data-metrics="view_item_list"
    data-mt-list-id="{{ list_id }}"
    data-mt-list-name="{{ data.category.name | default: data.brand.name | default: 'Busca' }}"
    {% if current_page > 1 %}
      hx-select-oob="#li-search-results-grid"
      hx-swap-oob="beforeend"
    {% endif %}
  >
    {% for product in data.search_result.products %}
      {% render 'shared/components/product-card/index', product: product, forloop: forloop, sizes: "(max-width: 1023px) 50vw, 400px" %}
    {% endfor %}
  </div>
{% else %}
  <div class="flex flex-col items-center justify-center gap-5 py-10">
    <svg data-id="search-icon" class="fill-current size-10" role="img" aria-hidden="true">
      <use xlink:href="/static/img/fontawesome-solid.svg#magnifying-glass" href="/static/img/fontawesome-solid.svg#magnifying-glass"></use>
    </svg>
    <p class="text-xl font-semibold">Nenhum produto encontrado</p>
  </div>
{% endif %}
