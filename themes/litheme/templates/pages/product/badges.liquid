{%- assign product = data.product -%}
{%- assign price = product.selected_sku.price | default: product.price -%}
{% if product.available and price.upon_request != true and product.hide_price != true %}
  {%- assign discount_percentage = price.discount_percentage -%}
  {%- assign offers_teasers = price.offers_teasers -%}
{% endif %}
<div class="flex flex-wrap gap-x-1">
  {%- if product.free_shipping -%}
    <span class="badge badge-soft badge-success badge-sm mb-2">
      Frete Grátis
    </span>
  {%- endif -%}
  {%- if discount_percentage > 0 -%}
    <span class="badge badge-soft badge-primary badge-sm mb-2">
      {{ discount_percentage | round: 0 }}% off
    </span>
  {%- endif -%}
  {%- for teaser in offers_teasers -%}
    <span class="badge badge-soft badge-primary badge-sm mb-2">
      {{ teaser }}
    </span>
  {%- endfor -%}
</div>
