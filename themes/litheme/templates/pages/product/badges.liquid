{%- assign product = data.product -%}
{%- assign price = product.selected_sku.price | default: product.price -%}
{% if product.available and price.upon_request != true and product.hide_price != true %}
  {%- assign discount_percentage = price.discount_percentage -%}
{% endif %}
{%- if tag_location == 'after_title' -%}
  <div class="hidden md:flex flex-wrap gap-x-3">
    {%- if discount_percentage > 50 -%}
      <span class="badge badge-soft badge-primary mt-4">
        Super Oferta
      </span>
    {%- endif -%}
    {%- if discount_percentage > 0 -%}
      <span class="badge badge-soft badge-primary mt-4">
        {{ discount_percentage | round: 0 }}% off
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
{%- if tag_location == 'with_image' -%}
  <div class="absolute left-3 top-3 flex flex-col gap-3">
    {%- if discount_percentage > 0 -%}
      <span class="flex flex-col items-center justify-center size-16 rounded-full bg-primary text-primary-content text-sm font-light leading-4 uppercase text-center">
        <span class="text-base font-normal leading-4">{{ discount_percentage | round: 0 }}%</span>off
      </span>
    {%- endif -%}
    {%- if product.free_shipping -%}
      <span class="flex flex-col items-center justify-center size-16 rounded-full bg-primary text-primary-content text-sm font-base leading-4 uppercase text-center">
        Frete Grátis
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
