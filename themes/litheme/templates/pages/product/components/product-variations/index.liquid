{% assign product = data.product %}
{% assign selected_sku = product.selected_sku %}

<!-- Options (SKU Selector) -->
{% if product.options.size > 0 %}
  {% render 'pages/product/components/options/index', target_id: target_id %}
{% endif %}

<!-- Buy Button or Notify Me -->
<div id="{% if target_id %}{{ target_id }}{% else %}product-buy-button-container{% endif %}">
  {%- capture login_to_see_price -%}
    <a href="/conta/login?next={{ ctx.url.path | url_encode }}" class="btn btn-block btn-primary btn-lg" data-testid="li-product-login-to-see-price">Identifique-se para ver preço</a>
  {%- endcapture -%}
  {% if selected_sku %}
    {% if selected_sku.price.upon_request %}
      {% render 'pages/product/components/upon-request/index', selected_sku: selected_sku %}
    {% elsif selected_sku.available and product.hide_price %}
      {{ login_to_see_price }}
    {% elsif selected_sku.available %}
      {% render 'pages/product/components/buy-button/index', selected_sku: selected_sku, is_floating: is_floating %}
    {% else %}
      {% render 'pages/product/components/notify-me/index', selected_sku: selected_sku %}
    {% endif %}
  {% elsif product.price.upon_request %}
    {% render 'pages/product/components/upon-request/index' %}
  {% elsif product.hide_price %}
    {{ login_to_see_price }}
  {% else %}
    {% render 'pages/product/components/buy-button/index', selected_sku: selected_sku, is_floating: is_floating %}
  {% endif %}
</div>

